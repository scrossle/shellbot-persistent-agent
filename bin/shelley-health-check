#!/bin/bash
# Comprehensive hourly health check: gateway, service, quota, resources
set -e

GATEWAY_URL="http://169.254.169.254/gateway/llm/_/gateway/fireworks/inference/v1/chat/completions"
SHELLEY_DB="/home/exedev/.config/shelley/shelley.db"
HEALTH_STATUS_FILE="/tmp/shelley-health-status.txt"
OWNER_EMAIL=$(cat /home/exedev/.agent/owner-email 2>/dev/null || echo "shaun@whatever.ca")
CLAUDE_TIMEOUT=60

# Non-agentic checks - returns JSON with issues found
check_health() {
  local issues=""
  
  # 1. Gateway connectivity
  local gw_code=$(curl -s -m 5 -o /dev/null -w "%{http_code}" "$GATEWAY_URL" 2>/dev/null || echo "000")
  if [ "$gw_code" = "000" ]; then
    issues="$issues\n- LLM gateway unreachable (timeout)"
  elif [ "$gw_code" = "502" ] || [ "$gw_code" = "503" ]; then
    issues="$issues\n- LLM gateway error (HTTP $gw_code)"
  fi
  
  # 2. Shelley service
  if ! systemctl is-active --quiet shelley.service; then
    issues="$issues\n- Shelley service not running"
  fi
  
  # 3. Database file
  if [ ! -r "$SHELLEY_DB" ]; then
    issues="$issues\n- Shelley database not readable"
  fi
  
  # 4. Shelley logs for recent errors
  local recent_errors=$(journalctl -u shelley.service -n 50 --no-pager 2>/dev/null | grep -iE "fatal|panic|crash" | wc -l || echo "0")
  if [ "$recent_errors" -gt 0 ]; then
    issues="$issues\n- Recent error/panic in shelley logs ($recent_errors errors)"
  fi
  
  # 5. System resources
  local mem_usage=$(free | awk '/^Mem:/ {printf "%.0f", $3/$2 * 100}')
  if [ "$mem_usage" -gt 90 ]; then
    issues="$issues\n- Memory usage critical ($mem_usage%)"
  fi
  
  local disk_usage=$(df / | awk 'NR==2 {print $5}' | sed 's/%//')
  if [ "$disk_usage" -gt 90 ]; then
    issues="$issues\n- Disk usage critical ($disk_usage%)"
  fi
  
  # 6. Test quota/billing - make a cheap test call
  local quota_test_response=$(curl -s -m 10 \
    -X POST "$GATEWAY_URL" \
    -H "Content-Type: application/json" \
    -d '{"model":"test","messages":[]}' 2>&1 || echo "timeout")
  
  if [[ "$quota_test_response" =~ "402" ]]; then
    issues="$issues\n- Payment required / quota exceeded (HTTP 402)"
  elif [[ "$quota_test_response" =~ "429" ]]; then
    issues="$issues\n- Rate limited (HTTP 429)"
  fi
  
  # Return issues (or empty if all OK)
  if [ -n "$issues" ]; then
    echo -e "$issues"
  else
    echo ""
  fi
}

escalate_to_claude() {
  local issues="$1"
  local now=$(date '+%Y-%m-%d %H:%M:%S')
  
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Health check found issues, invoking Claude..."
  
  local claude_prompt="You are Shelley, a persistent agent. The hourly health check found these issues:

$issues

The agent's infrastructure has detected these problems (this is a non-agentic report). Assess what's wrong and suggest immediate steps for the sysadmin. Keep it brief (3-4 sentences max)."

  local claude_response
  claude_response=$(timeout $CLAUDE_TIMEOUT claude -p "$claude_prompt" 2>&1 || echo "Claude invocation timed out")
  
  local email_body="SHELLEY HEALTH CHECK - ISSUES DETECTED

Time: $now

===== PROBLEMS FOUND =====
$issues

===== CLAUDE CODE ASSESSMENT =====

$claude_response

===== NEXT STEPS =====

Check the issues above and take corrective action. If unsure, try:
  - systemctl status shelley.service
  - journalctl -u shelley.service -n 100
  - df -h (disk usage)
  - free -h (memory)
  - curl -v $GATEWAY_URL (gateway test)

===== SYSTEM INFO =====

This assessment was generated by Claude Code via the hourly health check system.
Non-agentic checks run regardless of Shelley's operational state."

  local payload
  payload=$(jq -n \
    --arg to "$OWNER_EMAIL" \
    --arg subject "[SHELLEY ALERT] Health check issues at $now" \
    --arg body "$email_body" \
    '{to: $to, subject: $subject, body: $body}')

  curl -s -X POST http://169.254.169.254/gateway/email/send \
    -H "Content-Type: application/json" \
    -d "$payload" > /dev/null 2>&1 || true

  echo "Alert email sent to $OWNER_EMAIL"
}

# Main
ISSUES=$(check_health)

if [ -z "$ISSUES" ]; then
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Health check: all systems OK"
  echo "OK" > "$HEALTH_STATUS_FILE"
  exit 0
else
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Health check: ISSUES FOUND"
  echo "$ISSUES"
  escalate_to_claude "$ISSUES"
  exit 1
fi
